{
  "name": "@garden/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Garden Planner desktop app: React renderer in an Electron shell",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/launch-electron.mjs",
    "start": "npm run build && node scripts/launch-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron"
  },
  "dependencies": {
    "@garden/core": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  }
}
