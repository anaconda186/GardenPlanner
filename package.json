{
  "name": "garden-planner",
  "version": "0.0.0",
  "private": true,
  "description": "Garden planning app: bed layout, climate-derived planting dates, care schedules and recommendations",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @garden/desktop",
    "build": "npm run build --workspace @garden/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p apps/desktop --noEmit && tsc -p apps/desktop/electron --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise packages apps",
    "secrets": "secretlint --secretlintignore .gitignore \"**/*\"",
    "security:electron": "node scripts/electron-security.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run boundaries && npm run test && npm run secrets && npm run security:electron",
    "prepare": "lefthook install || exit 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-pattern": "^13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "secretlint": "^13.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
