# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
dist-electron/
build/
out/
release/
*.tsbuildinfo
.vite/

# Garden data — NEVER commit. Contains the user's real garden and location.
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
/data/
/photos/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
!**/fixtures/**/*.key

# SSH keys, whatever they are named. Note secretlint does not scan extensionless
# or .pem files at all, so this list is the only thing standing between a stray
# key file and a public repository.
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*_rsa
*_ed25519
known_hosts*

# Claude Code — share settings.json, keep local overrides private
.claude/settings.local.json
.claude/logs/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Test / coverage
coverage/
.nyc_output/
*.lcov

# Logs
*.log
npm-debug.log*
logs/
